{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.onekit.tools" }],
      "destination": "https://onekit.tools/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/", "destination": "/blog/index.html" },
    { "source": "/blog/calculator", "destination": "/blog/calculator.html" },
    { "source": "/blog/privacy-tools-2026", "destination": "/blog/privacy-tools-2026.html" },
    { "source": "/blog/stop-pasting-secrets-into-chatgpt", "destination": "/blog/stop-pasting-secrets-into-chatgpt.html" },
    { "source": "/blog/what-is-llms-txt", "destination": "/blog/what-is-llms-txt.html" },
    { "source": "/blog/json-mistakes", "destination": "/blog/json-mistakes.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/contact/", "destination": "/contact/index.html" },
    { "source": "/tools/:id", "destination": "/index.html" },
    { "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
